# Environment template for the AppWorld backend
#
# Copy the entries you need into `research/.env` (which is gitignored — never commit it):
#
#     cat research/appworld_backend/env.appworld.example >> research/.env
#     # then fill in the four *_API_KEY values
#
# This file exists because the repo's `research/.env.example` predates the AppWorld work and
# lists no judge (gemini) variables at all, so a collaborator building `.env` from it alone
# gets through trajectory generation and then fails at the judging stage.
#
# Every model id below is pinned EXPLICITLY on purpose. The judge modules each read their own
# model_env var and fall back to their own hardcoded default, and those defaults are NOT
# consistent:
#
#     stage1  (eval_v3-1/stage1/judge.py)                   -> "@vertexai/gemini-3.1-pro-preview"
#     stage2  (eval_v3-1/stage2/judge.py)                   -> "@vertexai-hs3645/gemini-3.1-pro-preview"
#     action  (eval_v3-2/stage3_action_annotation)          -> "@vertexai-hs3645/gemini-3.1-pro-preview"
#     reqmt   (eval_v4/stage2/proposed_requirement)         -> "@vertexai-hs3645/gemini-3.1-pro-preview"
#
# Note stage1 lacks the `-hs3645` prefix the others have. Leaving these unset therefore makes
# stage1 talk to a different model id than the rest of the chain, which on the NYU gateway is
# a hard failure rather than a subtle one. Worse, two collaborators can silently end up on
# different judges: whoever sets the vars is fine, whoever relies on defaults is not, and the
# resulting scores are not poolable. Pin all four.

# ---------------------------------------------------------------- judge (gemini-3.1-pro)
# One key, used by all four judge stages.
GEMINI_PRO_API_KEY=
GEMINI_PRO_BASE_URL=https://ai-gateway.apps.cloud.rt.nyu.edu/v1
GEMINI_PRO_MODEL_STAGE1=@vertexai-hs3645/gemini-3.1-pro-preview
GEMINI_PRO_MODEL_STAGE2=@vertexai-hs3645/gemini-3.1-pro-preview
GEMINI_PRO_MODEL_STAGE3_ACTION=@vertexai-hs3645/gemini-3.1-pro-preview
GEMINI_PRO_MODEL_PROPOSED_REQUIREMENT=@vertexai-hs3645/gemini-3.1-pro-preview

# ---------------------------------------------------------------- agent models (stage 1)
# gemini-3-flash is one of the five agents under test. Its provider reads GOOGLE_API_KEY,
# which on this gateway is not a valid credential, so gen_trajectories.py re-points
# GOOGLE_API_KEY at GEMINI_PRO_API_KEY at runtime *after* imports (research/config.py calls
# load_dotenv(override=True) on import, which would otherwise clobber the assignment).
# Set GEMINI_FLASH_* anyway so the flash judge variant stays runnable.
GEMINI_FLASH_API_KEY=
GEMINI_FLASH_BASE_URL=https://ai-gateway.apps.cloud.rt.nyu.edu/v1

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# qwen3-8b: the agent path reads QWEN_API_KEY, the judge path falls back to DASHSCOPE_API_KEY.
QWEN_API_KEY=
DASHSCOPE_API_KEY=

# ---------------------------------------------------------------- AppWorld + run tuning
APPWORLD_ROOT=/Users/maokaifang/appworld-root

# Judge HTTP timeout, in seconds, applied as a runtime override in run_pipeline.py /
# run_action_centric.py / run_requirement.py. Do not lower this. A single judged cell has a
# measured median of ~460s and a p90 of ~1690s, while the underlying modules ship 600s
# (OpenAI SDK default) and hardcoded 120s/180s urlopen timeouts. Those ceilings are what
# broke earlier concurrent batches; 1800s is the headroom that makes --workers usable.
HALLUCI_JUDGE_TIMEOUT=1800
HALLUCI_JUDGE_RETRIES=4
